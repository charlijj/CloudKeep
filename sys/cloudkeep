# CloudKeep — landing page + gateway (hardened)

# --- Default catch-all: drop any request not for cloudkeep-auth.duckdns.org ---
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}

# --- Main site ---
server {

    server_name cloudkeep-auth.duckdns.org;

    root  /var/www/html/cloudkeep;
    index index.html;

    access_log /var/log/nginx/cloudkeep.access.log;
    error_log  /var/log/nginx/cloudkeep.error.log warn;

    # --- Request shape limits ---
    client_max_body_size        1k;
    client_body_buffer_size     1k;
    client_header_buffer_size   1k;
    large_client_header_buffers 2 1k;

    # --- Timeouts (slow-loris / slow-POST defense) ---
    client_body_timeout    10s;
    client_header_timeout  10s;
    keepalive_timeout      15s;
    send_timeout           10s;

    # --- Connection limiting (per-IP) ---
    # NOTE: request-RATE limiting (limit_req) is intentionally NOT applied at
    # the server level. A cold page load fires a burst of static-asset requests;
    # a server-wide limit_req returns 503 (an HTML error page) for the overflow,
    # which the browser then rejects as a bad-MIME module load. Rate limiting now
    # lives only on /ck/auth/ (brute-force surface). limit_conn is safe globally.
    limit_conn cloudkeep_conn 10;

    # --- Restrict HTTP methods ---
    if ($request_method !~ ^(GET|HEAD|POST|OPTIONS)$) {
        return 405;
    }

    # --- Security headers (site-wide baseline) ---
    add_header X-Frame-Options              "DENY"             always;
    add_header X-Content-Type-Options       "nosniff"          always;
    add_header Referrer-Policy              "no-referrer"      always;
    add_header Permissions-Policy           "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()" always;
    add_header Cross-Origin-Opener-Policy   "same-origin"      always;
    add_header Cross-Origin-Resource-Policy "same-origin"      always;
    add_header Content-Security-Policy      "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'none'; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;

    # --- Block hidden files (but allow ACME for future TLS) ---
    location ~ /\.(?!well-known) {
        deny all;
        access_log off;
        log_not_found off;
    }

    # --- Block common probe paths and sensitive extensions ---
    location ~* \.(env|git|sql|bak|swp|log|ini|conf|yml|yaml)$ { deny all; }
    location ~* /(wp-|xmlrpc\.php|administrator/|admin\.php|phpmyadmin|\.aws|\.ssh) { deny all; }

    autoindex off;

    # ================================================================
    # Existing app (port 3001) — paths unchanged
    # ================================================================

    location /ws {
        proxy_pass http://10.10.10.2:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host       $host;
        proxy_set_header X-Real-IP  $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /internal/status {
        proxy_pass http://10.10.10.2:3001/status;
        proxy_http_version 1.1;
        proxy_set_header Host       $host;
        proxy_set_header X-Real-IP  $remote_addr;
    }

    location /ws-health {
        proxy_pass http://10.10.10.2:3001/health;
        proxy_http_version 1.1;
    }

    # ================================================================
    # CloudKeep gateway (port 8000) — all paths prefixed /ck/
    # ================================================================

    # Auth API — inherits site-wide security headers (no add_header here).
    # Request-rate limiting lives HERE (the brute-force surface), not globally,
    # so static-asset bursts on cold load are never throttled. FastAPI also
    # rate-limits /auth/login per-IP, so this is defense in depth.
    location /ck/auth/ {
        limit_req zone=cloudkeep_req burst=10 nodelay;
        proxy_pass http://10.10.10.2:8000/auth/;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # VNC WebSocket bridge.
    location /ck/ws {
        proxy_pass http://10.10.10.2:8000/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host       $host;
        proxy_set_header X-Real-IP  $remote_addr;
        proxy_buffering    off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Live serial-console (boot log) WebSocket — same upgrade/streaming setup as
    # the VNC bridge; proxy_buffering off so log lines arrive in real time.
    location /ck/console {
        proxy_pass http://10.10.10.2:8000/console;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host       $host;
        proxy_set_header X-Real-IP  $remote_addr;
        proxy_buffering    off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Control API (REST): /ck/vms, /ck/resources, /ck/vms/{id}/session, etc.
    # Longest-prefix match means /ck/auth/ and /ck/ws above still win; this is
    # the catch-all for the rest of the control plane. Not rate-limited (these
    # are authenticated, low-volume calls); /ck/auth/ keeps its brute-force cap.
    location /ck/ {
        proxy_pass http://10.10.10.2:8000/;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Gateway SPA.
    # ^~ beats the regex .html cache block so /app/ gets THIS CSP, not 'script-src none'.
    # Because this location sets add_header, NGINX won't inherit parent headers — repeat them all.
    location ^~ /app/ {
        add_header X-Frame-Options              "DENY"        always;
        add_header X-Content-Type-Options       "nosniff"     always;
        add_header Referrer-Policy              "no-referrer" always;
        add_header Permissions-Policy           "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()" always;
        add_header Cross-Origin-Opener-Policy   "same-origin" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        add_header Strict-Transport-Security    "max-age=31536000" always;
        # Relaxed CSP required by RFB.js:
        #   style-src unsafe-inline  — RFB sets inline canvas styles
        #   img-src blob:            — cursor images
        #   worker-src blob:         — framebuffer decoder workers
        #   connect-src wss://       — WebSocket (explicit origin avoids browser edge cases)
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' wss://cloudkeep-auth.duckdns.org; worker-src blob:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'" always;
        try_files $uri $uri/ /app/index.html;
    }

    # ================================================================
    # Static assets + landing page
    # ================================================================

    # noVNC is shipped as a single pre-bundled, version-pinned file
    # (lib/novnc.bundle.js?v=<ver>). Cache-bust is the ?v= query, so the file
    # itself is safe to serve immutable for a year — zero revalidation on repeat
    # connects. ^~ ensures the correct application/javascript MIME type.
    location ^~ /lib/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Hand-maintained SPA assets (app.js, style.css) — short cache + ETag
    # revalidation so edits show up quickly without a forced bypass.
    location ^~ /assets/ {
        add_header Cache-Control "public, max-age=300, no-transform" always;
        try_files $uri =404;
    }

    location ~* \.(html|css|svg|png|jpg|jpeg|gif|webp|ico|woff2?)$ {
        expires 1h;
        add_header Cache-Control "public, no-transform" always;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    # Compression
    gzip on;
    gzip_vary on;
    gzip_min_length 256;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript image/svg+xml;

    # HTTP/2 multiplexes the SPA assets over one connection (no 6-connection
    # HTTP/1.1 cap, no per-request connection churn). If Certbot ever rewrites
    # these listen lines and drops `http2`, re-add it.
    listen 443 ssl http2; # managed by Certbot
    listen [::]:443 ssl http2 ipv6only=on; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/cloudkeep-auth.duckdns.org/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/cloudkeep-auth.duckdns.org/privkey.pem; # managed by Certbot

    # TLS options inlined (was: include /etc/letsencrypt/options-ssl-nginx.conf +
    # ssl_dhparam). Those two files are only written by certbot's *nginx
    # installer* plugin; we issue with `certbot certonly` (webroot), which never
    # creates them, so the include failed with ENOENT on a fresh host. Inlining
    # makes the vhost self-contained and host-independent. Ciphers are ECDHE-only
    # (+ TLS 1.3), so no ssl_dhparam / DHE params file is needed.
    ssl_session_cache shared:le_nginx_SSL:10m;
    ssl_session_timeout 1440m;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305";

    add_header Strict-Transport-Security "max-age=31536000" always; # managed by Certbot

}

server {
    if ($host = cloudkeep-auth.duckdns.org) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name cloudkeep-auth.duckdns.org;
    return 444;
}
