# CloudKeep VNC gateway — hardened systemd service.
#
# Install:
#   sudo cp sys/systemd/cloudkeep-gateway.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cloudkeep-gateway.service
#
# Inspect hardening score:  systemd-analyze security cloudkeep-gateway.service
# Logs:                     journalctl -u cloudkeep-gateway -f
#
# NOTE: adjust the wg0 dependency below to match how WireGuard is brought up on
# this host (wg-quick@wg0 vs systemd-networkd vs NetworkManager). Check with:
#   systemctl list-units --type=service | grep -i wg

[Unit]
Description=CloudKeep VNC gateway (FastAPI/uvicorn)
Documentation=https://github.com/charlijj/CloudKeep
# The gateway binds the WireGuard address (10.10.10.2) and relays to the local
# VNC server, so both should be up first. These are soft deps + ordering; if
# wg0 is briefly not ready at boot the bind fails and Restart= retries.
After=network-online.target wg-quick@wg0.service tigervncserver@:1.service
Wants=network-online.target wg-quick@wg0.service tigervncserver@:1.service
# Don't give up if early boot needs a few bind retries while wg0 settles.
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=exec
User=app
Group=app
WorkingDirectory=/opt/rdgateway/src
ExecStart=/opt/rdgateway/venv/bin/python /opt/rdgateway/src/run.py
# JWT_SECRET is NOT injected here on purpose — config.py loads /opt/rdgateway/
# src/.env (mode 600, owned by app) directly, so the secret stays out of the
# service's process environment. Fail-closed: no secret -> app refuses to start.
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

Restart=on-failure
RestartSec=3
TimeoutStartSec=30

# ---------------------------------------------------------------------------
# Hardening (least privilege). Verify with: systemd-analyze security
# If the service ever fails to start after a dependency upgrade, the two knobs
# most likely to need relaxing are MemoryDenyWriteExecute and SystemCallFilter.
# ---------------------------------------------------------------------------
NoNewPrivileges=yes
# Drop every capability — binds an unprivileged port (8000), needs none.
CapabilityBoundingSet=
AmbientCapabilities=

# Filesystem: read-only system, no /home, private /tmp, hidden /proc.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
# The app only reads its source + .env (read-only is fine); it writes nothing
# to disk (logs go to journald). No ReadWritePaths needed.

# Kernel / system surface.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

# Syscalls: standard service allowlist, native ABI only.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

# Network: only IPv4/IPv6 + unix sockets, and only loopback (VNC) + the
# WireGuard subnet (the EC2 peer + our own bind). Everything else is denied,
# so a compromised gateway cannot reach the public internet.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost 10.10.10.0/24

UMask=0077

[Install]
WantedBy=multi-user.target
